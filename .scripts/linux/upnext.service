[Unit]
Description=upnext media feed daemon
Documentation=https://github.com/timmo001/upnext
# Starts with the desktop session, once the compositor has passed WAYLAND_DISPLAY
# and OMARCHY_HOST to systemd, so auto-open can launch a browser.
After=network-online.target graphical-session.target
Wants=network-online.target
PartOf=graphical-session.target

[Service]
Type=simple
Environment=XDG_RUNTIME_DIR=%t
# Bun's garbage collector otherwise wakes every second, even while idle.
# Every 5 seconds still hands memory back soon after a check. Turning the
# timer off would leave it held until the next check.
Environment=BUN_GC_TIMER_INTERVAL=5000
ExecStart=/usr/bin/upnext serve
# The Effect runtime exits 130 when systemd stops it.
SuccessExitStatus=130
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
