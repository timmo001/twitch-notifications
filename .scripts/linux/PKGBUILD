#!/bin/sh
# PKGBUILD for twitch-notifications-git (binary) package

pkgname=twitch-notifications-git
pkgver=${ARCH_PKGVER}
pkgrel=1
pkgdesc="A Go daemon application that monitors Twitch channels you follow and sends desktop notifications when they go live"
source=('twitch-notifications' 'twitch-notifications-tui' 'twitch-notifications-recheck' 'twitch-notifications-restart' 'twitch-notifications.desktop' 'LICENSE' 'twitch-notifications.svg')
arch=('x86_64')

url="https://github.com/timmo001/twitch-notifications"
license=('Apache-2.0')
keywords=('twitch' 'notifications' 'desktop' 'daemon' 'livestream')
depends=('libnotify' 'uwsm')
provides=('twitch-notifications')
conflicts=('twitch-notifications')
options=('!strip')

build() {
  # No-op: we package a prebuilt binary provided via source=("twitch-notifications" ...)
  :
}

package() {
  install -dm755 "$pkgdir/usr/bin"
  install -dm755 "$pkgdir/usr/share/applications"
  install -dm755 "$pkgdir/usr/share/licenses/$pkgname"
  install -dm755 "$pkgdir/usr/share/icons/hicolor/scalable/apps"
  
  install -Dm755 twitch-notifications "$pkgdir/usr/bin/twitch-notifications"
  install -Dm755 twitch-notifications-tui "$pkgdir/usr/bin/twitch-notifications-tui"
  install -Dm755 twitch-notifications-recheck "$pkgdir/usr/bin/twitch-notifications-recheck"
  install -Dm755 twitch-notifications-restart "$pkgdir/usr/bin/twitch-notifications-restart"
  install -Dm644 twitch-notifications.desktop "$pkgdir/usr/share/applications/twitch-notifications.desktop"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 twitch-notifications.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/twitch-notifications.svg"
}
