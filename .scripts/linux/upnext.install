post_install() {
  _upnext_configure_user_service start
}

post_upgrade() {
  _upnext_configure_user_service try-restart
}

pre_remove() {
  _upnext_disable_user_service
}

_upnext_unit="upnext.service"

# The user who ran the install through sudo or pkexec, if not root.
_upnext_installing_user() {
  local user="${SUDO_USER:-}"

  if [ -z "$user" ] && [ -n "${PKEXEC_UID:-}" ]; then
    user="$(id -nu "$PKEXEC_UID" 2>/dev/null)" || user=""
  fi

  if [ -n "$user" ] && [ "$user" != "root" ]; then
    printf "%s" "$user"
  fi
}

# Runs systemctl --user for the installing user, if they have a running user session.
_upnext_user_systemctl() {
  local user="$1"
  shift
  local uid
  local runtime_dir
  local bus_path

  uid="$(id -u "$user" 2>/dev/null)" || return 1
  runtime_dir="/run/user/$uid"
  bus_path="$runtime_dir/bus"

  if [ ! -S "$bus_path" ]; then
    return 1
  fi

  runuser -u "$user" -- env \
    XDG_RUNTIME_DIR="$runtime_dir" \
    DBUS_SESSION_BUS_ADDRESS="unix:path=$bus_path" \
    systemctl --user "$@" >/dev/null 2>&1
}

_upnext_configure_user_service() {
  # start on first install; try-restart on upgrade, so a service the user
  # stopped on purpose stays stopped.
  local activate="${1:-start}"

  # reenable drops links from older releases, which were wanted by
  # default.target and started before the desktop session.
  if command -v systemctl >/dev/null 2>&1; then
    systemctl --global reenable "$_upnext_unit" >/dev/null 2>&1 || true
  fi

  local user
  user="$(_upnext_installing_user)"

  if [ -n "$user" ]; then
    _upnext_user_systemctl "$user" daemon-reload &&
      _upnext_user_systemctl "$user" reenable "$_upnext_unit" &&
      _upnext_user_systemctl "$user" "$activate" "$_upnext_unit"
  fi

  cat <<'EOF'
upnext: installed user service upnext.service

- Enabled for future desktop sessions (graphical-session.target).
- If the installing user has a running user session, it was started for them too.
- Each user's settings live in ~/.config/upnext/config.yml and channels.yml. A twitch-notifications config is imported on first run.

If the service isn't running in your current session, run:
  systemctl --user daemon-reload
  systemctl --user enable --now upnext.service
EOF
}

_upnext_disable_user_service() {
  if command -v systemctl >/dev/null 2>&1; then
    systemctl --global disable "$_upnext_unit" >/dev/null 2>&1 || true
  fi

  local user
  user="$(_upnext_installing_user)"

  if [ -n "$user" ]; then
    _upnext_user_systemctl "$user" disable --now "$_upnext_unit" || true
  fi
}
