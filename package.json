{
  "name": "upnext",
  "version": "2.2.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "bin": {
    "upnext": "./dist/upnext"
  },
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "build": "bun build src/index.ts --compile --minify --bytecode --format=esm --keep-names --no-compile-autoload-dotenv --no-compile-autoload-bunfig --outfile dist/upnext",
    "test": "bun test --pass-with-no-tests",
    "lint": "oxlint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\" \"packages/*/src/**/*.ts\" \"scripts/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"packages/*/src/**/*.ts\" \"scripts/**/*.ts\"",
    "check": "bun run lint && bun run typecheck && bun run format:check",
    "prepare": "effect-tsgo patch --typescript --force=false",
    "build:packages": "bun run --cwd packages/shared build && bun run --cwd packages/twitch build && bun run --cwd packages/youtube build && bun run --cwd packages/client build"
  },
  "dependencies": {
    "@effect/platform-bun": "4.0.6",
    "@timmo001/effect-upnext": "workspace:*",
    "@timmo001/effect-upnext-shared": "workspace:*",
    "effect": "4.0.6",
    "@timmo001/effect-twitch": "workspace:*",
    "@timmo001/effect-youtube": "workspace:*"
  },
  "devDependencies": {
    "@effect/tsgo": "0.61.0",
    "@oxlint/plugins": "1.89.0",
    "@timmo001/oxlint-rules": "0.6.3",
    "@types/bun": "1.4.4",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2005",
    "prettier": "3.9.10",
    "typescript": "7.0.2"
  },
  "workspaces": [
    "packages/*"
  ]
}
