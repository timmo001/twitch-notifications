{
  "schemaVersion": 1,
  "id": "timmo.upnext",
  "name": "Up Next",
  "version": "2.9.0",
  "author": "Timmo",
  "license": "Apache-2.0",
  "description": "Twitch live channels, YouTube uploads and a watch-later queue in one feed",
  "kinds": [
    "service",
    "bar-widget"
  ],
  "keepLoaded": true,
  "entryPoints": {
    "service": "Service.qml",
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "Up Next",
    "description": "Shows what is live and opens the Up Next feed",
    "category": "Media",
    "allowMultiple": false,
    "defaultSection": "center",
    "defaults": {
      "primaryOnly": false,
      "primaryOutput": "",
      "revealOnHover": true,
      "maxCounts": 2
    },
    "schema": [
      {
        "key": "primaryOnly",
        "type": "boolean",
        "label": "Primary output only",
        "defaultValue": false
      },
      {
        "key": "primaryOutput",
        "type": "string",
        "label": "Primary output",
        "defaultValue": "",
        "description": "Optional output name used when primary output only is enabled."
      },
      {
        "key": "revealOnHover",
        "type": "boolean",
        "label": "Reveal active state on hover",
        "defaultValue": true
      },
      {
        "key": "maxCounts",
        "type": "integer",
        "label": "Counts to show",
        "min": 1,
        "max": 2,
        "step": 1,
        "defaultValue": 2,
        "description": "Twitch live, then YouTube live and new uploads together. YouTube drops off first."
      }
    ]
  }
}
