{
  "name": "@timmo001/effect-twitch",
  "version": "2.1.1",
  "description": "Effect client for Twitch: sign-in, Helix, EventSub live notifications and upnext media items",
  "keywords": [
    "effect",
    "twitch",
    "helix",
    "eventsub",
    "upnext"
  ],
  "homepage": "https://github.com/timmo001/upnext/tree/main/packages/twitch#readme",
  "bugs": {
    "url": "https://github.com/timmo001/upnext/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/timmo001/upnext.git",
    "directory": "packages/twitch"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "dist",
    "README.md",
    "!src/**/*.test.ts"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepack": "bun run build"
  },
  "peerDependencies": {
    "effect": "4.0.4"
  },
  "dependencies": {
    "@timmo001/effect-upnext-shared": "2.1.1"
  },
  "devDependencies": {
    "effect": "4.0.4"
  }
}
