{
  "name": "@timmo001/effect-upnext",
  "version": "2.2.0",
  "description": "Effect client and protocol for the upnext media feed socket",
  "keywords": [
    "effect",
    "upnext",
    "twitch",
    "youtube",
    "rpc"
  ],
  "homepage": "https://github.com/timmo001/upnext/tree/main/packages/client#readme",
  "bugs": {
    "url": "https://github.com/timmo001/upnext/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/timmo001/upnext.git",
    "directory": "packages/client"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepack": "bun run build"
  },
  "dependencies": {
    "@effect/platform-node-shared": "4.1.0",
    "@timmo001/effect-upnext-shared": "2.2.0"
  },
  "peerDependencies": {
    "effect": "4.1.0"
  },
  "devDependencies": {
    "effect": "4.1.0"
  }
}
